# Dependencies & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
node_modules/

# Secrets & Environment variables
.env
.env.local
*.pem
*.key

# Build & Dist
dist/
build/
*.egg-info/

# Agent configuration / Memory rules (NEVER COMMIT)
CLAUDE.md
MEMORY.md
.agents/
skills-lock.json
*.log
.system_generated/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# IBM Bob / competition credentials (NEVER COMMIT)
competition.json
*apikey*.json
*api-key*.json
.bob/settings/auth-secrets.json

# Karpathy autoresearch clone (reference only, requires NVIDIA GPU)
autoresearch/

# Bob run stderr is empty on success; keep the JSON transcripts, drop the noise
results/bob_runs/*.err

# Local experimentation scaffolding — sweeps, autoresearch loops, their outputs.
# These run on this machine to find configurations; they are not part of the
# shipped artifact and are deliberately kept out of the repo.
local/
*.sweep.json
sweep_*.json
results/sweep_*
